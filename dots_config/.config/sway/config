output eDP-1 scale 1
set $mod Mod4
set $term kitty
set $menu rofi -show run
gaps outer 8
gaps inner 4
for_window [class="^.*"] border pixel 2
client.focused #ffffff #ffffff #ffffff #ffffff




exec fcitx5 &
exec nm-applet &
exec blueman-applet &
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
exec wl-paste --type text --watch cliphist store &
exec wl-paste --type image --watch cliphist store &
exec mako &
exec ~/script/swaybg_startup.sh &
exec autotiling &
exec udiskie &
# exec kbuildsycoca6 --noincremental &
exec waybar &
exec throne &


floating_modifier $mod

bindsym Print exec bash -c 'grim -g "$(slurp)" - | wl-copy && notify-send "screenshot"'


#clipboard
bindsym $mod+v exec cliphist list | rofi -dmenu -p "clipboard history" | cliphist decode | wl-copy
bindsym $mod+q exec $term
bindsym $mod+r exec $menu
bindsym Mod1+F4 kill
bindsym $mod+left focus left
bindsym $mod+down focus down
bindsym $mod+up focus up
bindsym $mod+right focus right
bindsym $mod+Shift+left move left
bindsym $mod+Shift+down move down
bindsym $mod+Shift+up move up
bindsym $mod+Shift+right move right
bindsym $mod+f fullscreen toggle
bindsym $mod+h layout toggle split
bindsym $mod+e exec nautilus
bindsym $mod+space floating toggle
bindsym $mod+a focus parent


bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ && notify-send -h string:x-canonical-private-synchronous:sys-notify -u low -t 1000 "Volume" "$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2*100)"%"}')"
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && notify-send -h string:x-canonical-private-synchronous:sys-notify -u low -t 1000 "Volume" "$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2*100)"%"}')"
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl s 10%+ && notify-send -h string:x-canonical-private-synchronous:sys-notify -u low -t 1000 "Brightness" "$(brightnessctl -m | awk -F, '{print $4}')"
bindsym XF86MonBrightnessDown exec brightnessctl s 10%- && notify-send -h string:x-canonical-private-synchronous:sys-notify -u low -t 1000 "Brightness" "$(brightnessctl -m | awk -F, '{print $4}')"


# Requires playerctl
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPrev exec playerctl previous


#gamma
bindsym $mod+Mod1+up exec ~/script/gamma.sh up

bindsym $mod+Mod1+down exec ~/script/gamma.sh down


#wallpaper
bindsym $mod+Shift+w exec ~/script/swaybg.sh






set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "0"


bindsym $mod+Shift+minus move scratchpad

bindsym $mod+minus scratchpad show

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10


#nerd-font
bindsym $mod+Shift+n exec cat "/home/t3chj4ck/nerdfont.txt" | rofi -dmenu -i | awk '{print $1}' | tr -d '\n' | wl-copy


### keyboard layout
input "type:keyboard" {
    xkb_layout "us,ru"
    xkb_options "grp:alt_space_toggle"
}

bindsym $mod+Shift+r reload
bindsym $mod+m exit

#app list
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway XDG_MENU_PREFIX=arch-

exec swayidle -w \
    timeout 600 hyprlock \
    before-sleep hyprlock



input "type:touchpad" {
    tap enabled
    natural_scroll enabled
}

input "type:pointer" {
    accel_profile flat
    pointer_accel 0
}

#window rule



